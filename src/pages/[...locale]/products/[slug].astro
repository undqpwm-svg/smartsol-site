---
/**
 * Страница продукта: /products/finpuls/ и т. п.
 * Тексты — src/content/pages/<язык>/products/<slug>.md, устроены так же,
 * как остальные страницы: шапка (header) и блоки по порядку.
 * В крошках: Главная → Продукты → название продукта.
 */
import '@/styles/line.css';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Blocks from '@/components/blocks/Blocks.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { useTranslations } from '@/i18n/ui';
import { buildAlternates, localeParam, localizedPath, splitEntryId } from '@/i18n/utils';

export async function getStaticPaths() {
  const entries = (await getCollection('pages', ({ data }) => !data.draft)).filter((entry) =>
    splitEntryId(entry.id).slug.startsWith('products/'),
  );
  return entries.map((entry) => {
    const { locale, slug: path } = splitEntryId(entry.id);
    const slug = path.slice('products/'.length);
    const languages = entries.filter((e) => splitEntryId(e.id).slug === path).map((e) => splitEntryId(e.id).locale);
    return {
      params: { locale: localeParam(locale), slug },
      props: { entry, locale, alternates: buildAlternates(languages, path) },
    };
  });
}

const { entry, locale, alternates } = Astro.props;
const t = useTranslations(locale);
const { Content, headings } = await render(entry);
const header = entry.data.header;
---

<BaseLayout locale={locale} title={entry.data.seo.title} description={entry.data.seo.description} alternates={alternates}>
  <div class="grid-plain">
    {
      header && (
        <PageHeader
          locale={locale}
          crumbs={[{ label: t('nav.products'), href: localizedPath(locale, 'products') }, { label: header.crumb ?? header.title }]}
          title={header.title}
          lead={header.lead}
          cta={header.cta}
          extra={header.extra}
        />
      )
    }
    <Blocks blocks={entry.data.blocks} locale={locale} standalone Content={Content} headings={headings} />
  </div>
</BaseLayout>
