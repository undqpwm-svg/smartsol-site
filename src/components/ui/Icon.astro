---
import { ICONS, type IconName } from './icons';

interface Props {
  name: IconName;
  /** Размер в px (ширина и высота) */
  size?: number;
  class?: string;
  /** Подпись для читалок; без неё иконка считается декоративной */
  label?: string;
}

const { name, size = 24, class: className, label, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={ICONS[name]}
  {...rest}
/>
