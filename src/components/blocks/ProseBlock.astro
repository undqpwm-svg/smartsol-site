---
/**
 * Длинный текст из тела Markdown-файла страницы (политика обработки данных).
 * Колонка не шире ~70 знаков, слева — оглавление по заголовкам второго уровня.
 */
import type { MarkdownHeading } from 'astro';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
  headings?: MarkdownHeading[];
}

const { locale, headings = [] } = Astro.props;
const t = useTranslations(locale);
const toc = headings.filter((h) => h.depth === 2);
---

<section class="seg prose-block">
  <div class="container-site">
    <div class="seg-grid">
      {
        toc.length > 0 && (
          <nav class="toc seg-left" aria-label={t('prose.toc')}>
            <p class="toc-title">{t('prose.toc')}</p>
            <ol role="list">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose seg-right">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .prose-block :global(.seg-grid) {
    --seg-pad: 0rem;
    padding-bottom: clamp(2.5rem, 1.25rem + 3.5vw, 5rem);
  }

  .toc {
    display: none;
  }

  @media (min-width: 64rem) {
    .toc {
      display: block;
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  .toc-title {
    font-weight: 600;
  }

  .toc ol {
    display: grid;
    gap: 0.375rem;
    margin-top: 0.75rem;
    font-size: var(--text-small);
  }

  .toc a {
    color: var(--color-stone);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-ink);
    text-decoration-line: underline;
  }

  .prose {
    max-width: 68ch;
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
    font-size: clamp(1.375rem, 1.15rem + 0.8vw, 1.75rem);
    line-height: 1.15;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.1875rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 0.875rem;
  }

  .prose :global(ul) {
    display: grid;
    gap: 0.375rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .prose :global(a) {
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, currentColor 38%, transparent);
  }

  .prose :global(strong) {
    font-weight: 600;
  }
</style>
