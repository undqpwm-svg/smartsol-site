---
/**
 * Частые вопросы на линии: заголовок слева, ответы справа.
 * Нативные <details>/<summary> — работают без JavaScript и с клавиатуры.
 * Разметка FAQPage для поисковиков — на этапе 4.
 */
import type { PageBlock } from '@/content.config';
import Icon from '@/components/ui/Icon.astro';
import Rich from '@/components/ui/Rich.astro';
import { whatsappUrl } from '@/data/site';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  block: Extract<PageBlock, { type: 'faq' }>;
  locale: Locale;
}

const { block, locale } = Astro.props;
const t = useTranslations(locale);
const titleId = `${block.id ?? 'faq'}-title`;
---

<section class="seg faq" id={block.id} aria-labelledby={titleId}>
  <div class="container-site">
    <div class="seg-grid">
      <div class="faq-head seg-left">
        <Rich as="h2" id={titleId} class="faq-title" text={block.title} locale={locale} />
        <a class="faq-wa u-link" href={whatsappUrl(t('wa.prefill'))} target="_blank" rel="noopener" data-place="faq">
          {t('cta.whatsappAria')}
          <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
      <div class="faq-list seg-right">
        {
          block.items.map((item) => (
            <details class="faq-item">
              <summary>
                <Rich text={item.q} locale={locale} />
                <span class="faq-icon" aria-hidden="true">
                  <Icon name="plus" size={20} />
                </span>
              </summary>
              <Rich as="div" class="faq-answer" text={item.a} locale={locale} block />
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq :global(.seg-grid) {
    --seg-pad: clamp(2.5rem, 1.25rem + 3.5vw, 5rem);
  }

  .faq-head {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .faq-title {
    font-size: clamp(1.75rem, 1.15rem + 1.9vw, 2.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .faq-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .faq-list {
    display: grid;
    margin-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
  }

  .faq-item {
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 3.5rem;
    padding-block: 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    font-weight: 600;
    line-height: 1.25;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background-color: var(--color-white);
    transition:
      transform 0.25s var(--ease-out-soft),
      background-color 0.2s,
      color 0.2s;
  }

  .faq-item summary:hover .faq-icon {
    background-color: var(--color-ink);
    color: var(--color-milk);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    max-width: 60ch;
    padding-bottom: 1.25rem;
    color: var(--color-stone);
  }

  .faq-answer :global(a) {
    color: var(--color-ink);
  }

  @media (min-width: 64rem) {
    .faq-head {
      justify-self: end;
      align-content: start;
      width: min(100%, calc(26rem + var(--spine-gap)));
    }

    .faq-list {
      margin-top: 0;
    }
  }
</style>
