---
/**
 * «Как мы работаем»: шаги — станции на линии с номерами.
 * Название шага прижато к линии слева, пояснение справа (на телефоне — друг под другом).
 * Номер загорается кораллом, когда до него доходит точка на линии.
 */
import '@/styles/line.css';
import type { PageBlock } from '@/content.config';
import Rich from '@/components/ui/Rich.astro';
import type { Locale } from '@/i18n/config';

interface Props {
  block: Extract<PageBlock, { type: 'steps' }>;
  locale: Locale;
}

const { block, locale } = Astro.props;
const titleId = `${block.id ?? 'steps'}-title`;
---

<section class="seg steps" id={block.id} aria-labelledby={titleId}>
  <div class="container-site">
    <div class="seg-grid steps-grid">
      <div class="steps-head seg-right">
        <Rich as="h2" id={titleId} class="steps-title" text={block.title} locale={locale} />
        {block.lead && <Rich as="p" class="steps-lead" text={block.lead} locale={locale} />}
      </div>
      <ol class="step-list" role="list">
        {
          block.items.map((item, i) => (
            <li class="step">
              <span class="junction step-num nums" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="step-title">
                <span class="sr-only">{i + 1}. </span>
                <Rich text={item.title} locale={locale} />
              </h3>
              <Rich as="p" class="step-text" text={item.text} locale={locale} />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .steps-title {
    font-size: clamp(1.75rem, 1.15rem + 1.9vw, 2.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .steps-lead {
    max-width: 44ch;
    margin-top: 0.875rem;
    color: var(--color-stone);
  }

  .step-list {
    display: grid;
    margin-top: 1.75rem;
  }

  .step {
    position: relative;
    display: grid;
    gap: 0.375rem;
    padding-block: 1.25rem;
  }

  /* Номер шага — станция на линии */
  .step-num {
    top: 1.125rem;
    left: calc(-1 * var(--spine-gap) - 1.125rem);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .step-title {
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4375rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .step-text {
    max-width: 50ch;
    color: var(--color-stone);
  }

  @media (min-width: 64rem) {
    .steps-head {
      grid-column: 2;
      grid-row: 1;
    }

    .step-list {
      grid-column: 1 / -1;
      grid-row: 2;
      grid-template-columns: subgrid;
      margin-top: 1.25rem;
    }

    .step {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      gap: 0;
      padding-block: 1.5rem;
    }

    .step-num {
      left: calc(var(--spine) - 1.125rem);
      top: 1.25rem;
    }

    .step-title {
      grid-column: 1;
      padding-right: var(--spine-gap);
      text-align: right;
    }

    .step-text {
      grid-column: 2;
      padding-left: var(--spine-gap);
    }
  }
</style>
