---
/**
 * Контакты: каналы крупными строками (сначала два номера WhatsApp — так быстрее всего),
 * справа — как работаем: удалённо по всему Казахстану. Адреса и реквизитов пока нет.
 * Все данные — из src/data/site.ts.
 */
import type { PageBlock } from '@/content.config';
import Icon from '@/components/ui/Icon.astro';
import Rich from '@/components/ui/Rich.astro';
import { SITE, emailHref, whatsappUrl } from '@/data/site';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  block: Extract<PageBlock, { type: 'contacts' }>;
  locale: Locale;
}

const { block, locale } = Astro.props;
const t = useTranslations(locale);
const titleId = `${block.id ?? 'contacts'}-title`;

const channels = [
  ...SITE.whatsapp.map((wa) => ({
    label: 'WhatsApp',
    value: wa.display,
    href: whatsappUrl(t('wa.prefill'), wa.digits),
    icon: 'whatsapp' as const,
    external: true,
    place: 'contacts',
  })),
  { label: t('contacts.email'), value: SITE.email, href: emailHref, icon: 'mail' as const },
  { label: 'Instagram', value: SITE.instagram.handle, href: SITE.instagram.url, icon: 'instagram' as const, external: true },
  { label: 'Threads', value: SITE.threads.handle, href: SITE.threads.url, icon: 'at' as const, external: true },
];
---

<section class="seg contacts" id={block.id} aria-labelledby={titleId}>
  <div class="container-site">
    <h2 id={titleId} class="sr-only">{block.title}</h2>
    <div class="contacts-grid">
      <ul class="channels" role="list">
        {
          channels.map((c) => (
            <li>
              <a
                class="channel"
                href={c.href}
                target={'external' in c ? '_blank' : undefined}
                rel={'external' in c ? 'noopener' : undefined}
                data-place={'place' in c ? c.place : undefined}
              >
                <span class="channel-icon" aria-hidden="true">
                  <Icon name={c.icon} size={22} />
                </span>
                <span class="channel-label">{c.label}</span>
                <span class="channel-value">{c.value}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="contacts-side">
        <div class="geo">
          <p class="geo-city">{t('contacts.geoTitle')}</p>
          <p class="geo-text">{t('footer.geo')}</p>
          {block.note && <Rich as="p" class="geo-note" text={block.note} locale={locale} />}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contacts {
    padding-block: 0 clamp(2.5rem, 1.25rem + 3.5vw, 5rem);
  }

  .contacts-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 64rem) {
    .contacts-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 0rem + 4vw, 5rem);
    }
  }

  .channels {
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
  }

  .channel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 1rem;
    padding-block: 1.125rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
    text-decoration: none;
  }

  .channel-icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-white);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .channel:hover .channel-icon {
    background: var(--color-ink);
    color: var(--color-milk);
  }

  .channel-label {
    font-size: var(--text-small);
    color: var(--color-stone);
  }

  .channel-value {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.875rem);
    font-weight: 700;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .channel:hover .channel-value {
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .contacts-side {
    display: grid;
    align-content: start;
    gap: 2rem;
  }

  .geo-city {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 700;
  }

  .geo-text,
  .geo-note {
    margin-top: 0.375rem;
    max-width: 40ch;
  }
</style>
