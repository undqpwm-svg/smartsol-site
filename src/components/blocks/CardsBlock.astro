---
/**
 * Карточки: заголовок слева от линии, карточки справа, по две в ряд.
 * Карточка с href — целиком ссылка (стрелка в углу); с link — кнопка внутри.
 * numbered — номера 01, 02… (возможности продукта, преимущества).
 */
import '@/styles/line.css';
import type { PageBlock } from '@/content.config';
import Icon from '@/components/ui/Icon.astro';
import Rich from '@/components/ui/Rich.astro';
import type { Locale } from '@/i18n/config';
import { localizeHref } from '@/i18n/utils';

interface Props {
  block: Extract<PageBlock, { type: 'cards' }>;
  locale: Locale;
}

const { block, locale } = Astro.props;
const titleId = `${block.id ?? 'cards'}-title`;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const href = (h: string) => (isExternal(h) ? h : localizeHref(h, locale));
---

<section class="seg cards" id={block.id} aria-labelledby={titleId}>
  <div class="container-site">
    <div class="seg-grid">
      <div class="cards-head seg-left">
        <Rich as="h2" id={titleId} class="cards-title" text={block.title} locale={locale} />
        {block.lead && <Rich as="p" class="cards-lead" text={block.lead} locale={locale} />}
        {
          block.all && (
            <a class="cards-all u-link" href={href(block.all.href)}>
              {block.all.label}
              <Icon name="arrow-right" size={18} />
            </a>
          )
        }
      </div>

      <ul class="cards-list seg-right" role="list">
        {
          block.items.map((item, i) => (
            <li class:list={['crd', item.href && 'crd-link']} data-reveal style={`--i:${i % 2}`}>
              {block.numbered && <span class="crd-num nums">{String(i + 1).padStart(2, '0')}</span>}
              <h3 class="crd-title">
                {item.href ? (
                  <a href={href(item.href)}>
                    <Rich text={item.title} locale={locale} />
                  </a>
                ) : (
                  <Rich text={item.title} locale={locale} />
                )}
              </h3>
              {item.text && <Rich as="p" class="crd-text" text={item.text} locale={locale} />}
              {item.href && (
                <span class="crd-arrow" aria-hidden="true">
                  <Icon name="arrow-right" size={18} />
                </span>
              )}
              {item.link && (
                <a
                  class="btn btn-dark btn-sm crd-btn"
                  href={href(item.link.href)}
                  target={isExternal(item.link.href) ? '_blank' : undefined}
                  rel={isExternal(item.link.href) ? 'noopener' : undefined}
                  data-place={isExternal(item.link.href) ? 'demo' : undefined}
                >
                  {item.link.label}
                  {isExternal(item.link.href) && <Icon name="arrow-up-right" size={16} />}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cards-head {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 0.875rem;
  }

  .cards-title {
    font-size: clamp(1.75rem, 1.15rem + 1.9vw, 2.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .cards-lead {
    max-width: 40ch;
    color: var(--color-stone);
  }

  .cards-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .cards-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 40rem) {
    .cards-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .cards-head {
      justify-items: end;
      text-align: right;
      align-self: start;
    }

    .cards-list {
      margin-top: 0;
    }
  }

  .crd {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.375rem 1.375rem 1.5rem;
    border-radius: var(--radius-card);
    background: var(--color-white);
    transition:
      transform 0.25s var(--ease-out-soft),
      box-shadow 0.25s var(--ease-out-soft);
  }

  /* Номер чёрный (коралл на белом — 3:1, мелкому тексту мало), коралловая — только точка */
  .crd-num {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-ink);
  }

  .crd-num::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-coral);
  }

  .crd-title {
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .crd-link .crd-title {
    padding-right: 2.75rem;
  }

  .crd-title a {
    text-decoration: none;
  }

  /* Вся карточка — ссылка */
  .crd-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .crd-title a:focus-visible {
    outline: none;
  }

  .crd-title a:focus-visible::after {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .crd-text {
    color: var(--color-stone);
  }

  .crd-arrow {
    position: absolute;
    top: 1.125rem;
    right: 1.125rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-milk);
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.25s var(--ease-out-soft);
  }

  .crd-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -18px color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  .crd-link:hover .crd-arrow {
    background: var(--color-coral);
    transform: translateX(2px);
  }

  .crd-btn {
    justify-self: start;
    margin-top: 0.5rem;
  }
</style>
