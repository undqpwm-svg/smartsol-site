---
/**
 * «Чем ещё мы занимаемся» на линии главной: все направления SmartSol —
 * не только 1С. Каждое направление — пересадка с линии: развязка на оси,
 * название прижато к линии слева, описание справа, вся строка — ссылка.
 * Так же устроены продукты на станции «1С», поэтому язык страницы один.
 */
import type { PageBlock } from '@/content.config';
import Icon from '@/components/ui/Icon.astro';
import Rich from '@/components/ui/Rich.astro';
import type { Locale } from '@/i18n/config';
import { localizeHref } from '@/i18n/utils';

interface Props {
  block: Extract<PageBlock, { type: 'services' }>;
  locale: Locale;
}

const { block, locale } = Astro.props;
const titleId = `${block.id ?? 'services'}-title`;
---

<section class="seg services" id={block.id} aria-labelledby={titleId}>
  <div class="container-site">
    <div class="seg-grid services-grid">
      <div class="services-head seg-right">
        <Rich as="h2" id={titleId} class="services-title" text={block.title} locale={locale} />
        {block.lead && <Rich as="p" class="services-lead" text={block.lead} locale={locale} />}
      </div>
      <ul class="svc-list" role="list">
        {
          block.items.map((item) => (
            <li class="svc">
              <span class="junction" aria-hidden="true" />
              <h3 class="svc-title">
                <a href={localizeHref(item.href, locale)}>
                  <Rich text={item.title} locale={locale} />
                </a>
              </h3>
              <div class="svc-body">
                <Rich as="p" class="svc-text" text={item.text} locale={locale} />
                <span class="svc-more" aria-hidden="true">
                  <Icon name="arrow-right" size={18} />
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .services-title {
    font-size: clamp(1.75rem, 1.15rem + 1.9vw, 2.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .services-lead {
    max-width: 44ch;
    margin-top: 0.875rem;
    color: var(--color-stone);
  }

  .svc-list {
    display: grid;
    margin-top: 1.75rem;
  }

  .svc {
    position: relative;
    display: grid;
    gap: 0.375rem;
    padding-block: 1.125rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
  }

  .svc .junction {
    top: 1.5rem;
    left: calc(-1 * var(--spine-gap) - 0.625rem);
  }

  .svc-title {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .svc-title a {
    text-decoration: none;
  }

  /* Вся строка — ссылка на направление */
  .svc-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .svc-title a:focus-visible {
    outline: none;
  }

  .svc-title a:focus-visible::after {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 8px;
  }

  .svc:hover .svc-title {
    text-decoration-line: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }

  .svc-body {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .svc-text {
    max-width: 52ch;
  }

  .svc-more {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-white);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .svc:hover .svc-more {
    background: var(--color-ink);
    color: var(--color-milk);
  }

  @media (min-width: 64rem) {
    .services-head {
      grid-column: 2;
      grid-row: 1;
    }

    .svc-list {
      grid-column: 1 / -1;
      grid-row: 2;
      grid-template-columns: subgrid;
      margin-top: 1.5rem;
    }

    .svc {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      gap: 0;
      padding-block: 1.25rem;
      border-top: 0;
    }

    .svc .junction {
      left: calc(var(--spine) - 0.625rem);
      top: 1.625rem;
    }

    /* Название прижато к линии слева — как подписи станций на схеме метро */
    .svc-title {
      grid-column: 1;
      padding-right: var(--spine-gap);
      text-align: right;
    }

    .svc-body {
      grid-column: 2;
      padding-left: var(--spine-gap);
    }
  }
</style>
