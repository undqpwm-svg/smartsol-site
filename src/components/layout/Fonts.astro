---
/**
 * Шрифты — свой хостинг из @fontsource, без запросов к Google.
 *
 * Подключаем только нужное:
 *   Geologica 600/700/800 — заголовки; Onest 400/500/600 — текст, кнопки, капсулы.
 *   Подмножества: cyrillic (русский), cyrillic-ext (казахские Ә Ғ Қ Ң Ө Ү Һ),
 *   latin (латиница, пробелы, знаки препинания), latin-ext (знак ₸).
 * Браузер скачивает файл, только если на странице есть символы из его unicode-range.
 * Шрифты первого экрана загружаются заранее (preload).
 *
 * «… Fallback» — системный Arial, подогнанный по метрикам (size-adjust и др.),
 * чтобы при подмене шрифта строки не перескакивали (меньше CLS).
 */
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const files = import.meta.glob<string>(
  [
    '/node_modules/@fontsource/geologica/files/geologica-{cyrillic,cyrillic-ext,latin,latin-ext}-{600,700,800}-normal.woff2',
    '/node_modules/@fontsource/onest/files/onest-{cyrillic,cyrillic-ext,latin,latin-ext}-{400,500,600}-normal.woff2',
  ],
  { query: '?url', import: 'default', eager: true },
);

type Subset = 'cyrillic' | 'cyrillic-ext' | 'latin' | 'latin-ext';

// Диапазоны символов — как у Google Fonts / @fontsource
const RANGES: Record<Subset, string> = {
  'cyrillic-ext': 'U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F',
  cyrillic: 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116',
  'latin-ext':
    'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF',
  latin:
    'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD',
};

const FAMILIES = [
  { family: 'Geologica', pkg: 'geologica', weights: [600, 700, 800] },
  { family: 'Onest', pkg: 'onest', weights: [400, 500, 600] },
] as const;

function fileUrl(pkg: string, subset: Subset, weight: number): string {
  const url = files[`/node_modules/@fontsource/${pkg}/files/${pkg}-${subset}-${weight}-normal.woff2`];
  if (!url) throw new Error(`Нет файла шрифта ${pkg} ${subset} ${weight}`);
  return url;
}

const faces: string[] = [];
for (const { family, pkg, weights } of FAMILIES) {
  for (const weight of weights) {
    for (const subset of Object.keys(RANGES) as Subset[]) {
      faces.push(
        `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};` +
          `src:url(${fileUrl(pkg, subset, weight)}) format('woff2');unicode-range:${RANGES[subset]}}`,
      );
    }
  }
}

// Подогнанные запасные шрифты (метрики посчитаны по файлам Geologica, Onest и Arial)
faces.push(
  `@font-face{font-family:'Geologica Fallback';font-weight:600 700;src:local('Arial Bold'),local('Arial-BoldMT');size-adjust:102.1%;ascent-override:95.5%;descent-override:26.9%;line-gap-override:0%}`,
  `@font-face{font-family:'Geologica Fallback';font-weight:800;src:local('Arial Bold'),local('Arial-BoldMT');size-adjust:104%;ascent-override:93.7%;descent-override:26.4%;line-gap-override:0%}`,
  `@font-face{font-family:'Onest Fallback';font-weight:400;src:local('Arial'),local('ArialMT');size-adjust:103.1%;ascent-override:94.1%;descent-override:29.6%;line-gap-override:0%}`,
  `@font-face{font-family:'Onest Fallback';font-weight:500;src:local('Arial'),local('ArialMT');size-adjust:104.4%;ascent-override:92.9%;descent-override:29.2%;line-gap-override:0%}`,
  `@font-face{font-family:'Onest Fallback';font-weight:600;src:local('Arial Bold'),local('Arial-BoldMT');size-adjust:98.8%;ascent-override:98.2%;descent-override:30.9%;line-gap-override:0%}`,
);

// Шрифты первого экрана: заголовок H1 (Geologica 800) и основной текст (Onest 400)
const critical: Subset[] = locale === 'en' ? ['latin'] : ['cyrillic', 'latin'];
const preloads = critical.flatMap((subset) => [
  fileUrl('geologica', subset, 800),
  fileUrl('onest', subset, 400),
]);
---

{preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={faces.join('')}></style>
